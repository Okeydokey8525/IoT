    {
        "id": "a46a40366ce311cb",
        "type": "function",
        "z": "256994368d45d3ad",
        "name": "Tính tiền điện",
        "func": "// Lấy số kWh từ chuỗi \"0.0026 kWh\"\nlet e = parseFloat(msg.payload) || 0;\nlet tien = 0;\n\n// Tính lũy tiến 6 bậc EVN cơ bản\nif (e <= 50) tien = e * 1893;\nelse if (e <= 100) tien = 50 * 1893 + (e - 50) * 1956;\nelse if (e <= 200) tien = 50 * 1893 + 50 * 1956 + (e - 100) * 2271;\nelse tien = 50 * 1893 + 50 * 1956 + 100 * 2271 + (e - 200) * 2860;\n\n// Format sang tiền Việt (VD: 15.200 VNĐ)\nmsg.payload = Math.round(tien).toLocaleString('vi-VN') + \" VNĐ\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1420,
        "y": 840,
        "wires": [
