    {
        "id": "74bbc3a3f531ad44",
        "type": "function",
        "z": "256994368d45d3ad",
        "name": "Tách U, I, P",
        "func": "let data = msg.payload;\n\n// Tự động giải mã nếu dữ liệu còn ở dạng chuỗi\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        data = {};\n    }\n}\n\n// 1. Bóc tách dữ liệu từ ESP32\nconst p = Number(data.P ?? data.power ?? 0);\nconst u = Number(data.U ?? data.voltage ?? 220);\nconst i = Number(data.I ?? data.current ?? 0);\nconst e = Number(data.E ?? 0).toFixed(4); // Lấy 4 số thập phân cho kWh\nconst state = String(data.state ?? \"NORMAL\");\n\n// 2. Đóng gói ra 5 cổng\nconst msgP = { payload: p, topic: \"Công suất (W)\" };\nconst msgU = { payload: u, topic: \"Điện áp (V)\" };\nconst msgI = { payload: i, topic: \"Dòng điện (A)\" };\nconst msgE = { payload: `${e} kWh`, topic: \"Điện năng tiêu thụ\" };\nconst msgState = { payload: state, topic: \"Trạng thái hệ thống\" };\n\nreturn [msgP, msgU, msgI, msgE, msgState];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1110,
        "y": 600,
        "wires": [
