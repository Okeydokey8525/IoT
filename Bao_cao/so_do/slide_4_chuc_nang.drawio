<mxfile><diagram name="slide_4_chuc_nang"><mxGraphModel adaptiveColors="auto" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;1. Đo và lọc&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Biến trở thay cảm biến&lt;br&gt;Lọc trung bình 8 mẫu&lt;br&gt;Tính P, I, điện năng E" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="200" as="geometry"/></mxCell><mxCell id="c2" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;2. Bảo vệ tại chỗ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;3 mức NORMAL, WARNING,&lt;br&gt;CRITICAL&lt;br&gt;Ngắt relay sau 3 s quá tải" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;verticalAlign=top;spacingTop=18;fillColor=#DCEBF7;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="300" height="200" as="geometry"/></mxCell><mxCell id="c3" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;3. Truyền MQTT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;telemetry mỗi 2 s&lt;br&gt;alarm, status (LWT)&lt;br&gt;control nhận lệnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="300" height="200" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;4. Giám sát, điều khiển&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Dashboard Node-RED&lt;br&gt;Tiền điện, log CSV&lt;br&gt;Nút cắt / bật nguồn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="1100" y="20" width="300" height="200" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c1" target="c2" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c2" target="c3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c3" target="c4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>