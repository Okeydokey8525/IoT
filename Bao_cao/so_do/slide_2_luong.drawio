<mxfile><diagram name="slide_2_luong"><mxGraphModel adaptiveColors="auto" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Luồng bảo vệ – ưu tiên cao, chạy mỗi 10 ms" style="swimlane;startSize=56;html=1;whiteSpace=wrap;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=22;fontStyle=1;fillColor=#DCEBF7;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="520" height="520" as="geometry"/></mxCell><mxCell id="c2" value="Luồng mạng – vòng lặp chính" style="swimlane;startSize=56;html=1;whiteSpace=wrap;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=22;fontStyle=1;fillColor=#FDEBD8;" vertex="1" parent="1"><mxGeometry x="940" y="20" width="520" height="520" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Đọc biến trở (ADC)&lt;/b&gt;&lt;br&gt;lọc trung bình 8 mẫu, tính P, I, E" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c1"><mxGeometry x="40" y="80" width="440" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Máy trạng thái&lt;/b&gt;&lt;br&gt;NORMAL → WARNING → CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c1"><mxGeometry x="40" y="230" width="440" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;LED, còi, relay&lt;/b&gt;&lt;br&gt;ngắt tải đúng 3 s sau khi quá tải" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c1"><mxGeometry x="40" y="380" width="440" height="100" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c3" target="c4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c4" target="c5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Kết nối Wi-Fi, MQTT&lt;/b&gt;&lt;br&gt;thử lại mỗi 5 s (có thể đứng ~5 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c2"><mxGeometry x="40" y="80" width="440" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Gửi dữ liệu&lt;/b&gt;&lt;br&gt;telemetry 2 s, alarm, nhận control" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c2"><mxGeometry x="40" y="230" width="440" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;In nhật ký Serial&lt;/b&gt;&lt;br&gt;kèm thời điểm chuyển trạng thái" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;" vertex="1" parent="c2"><mxGeometry x="40" y="380" width="440" height="100" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c8" target="c9" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;" edge="1" source="c9" target="c10" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Biến cờ dùng chung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;lệnh relay_on, relay_off, reset&lt;br&gt;cờ cảnh báo, nhật ký FSM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#2072B7;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=20;fillColor=#FFF7CC;strokeColor=#B8860B;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="300" height="130" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="c13" target="c4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" source="c4" target="c13" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="c9" target="c13" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2072B7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontSize=18;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" source="c13" target="c9" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Mất broker:&lt;/b&gt; chỉ luồng mạng chậm lại, luồng bảo vệ vẫn ngắt đúng 3 s (T5: WARNING t = 19.304 ms → CRITICAL t = 22.304 ms)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=13;fontFamily=Arial;fontSize=20;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>